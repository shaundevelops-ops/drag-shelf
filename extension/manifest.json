{
  "manifest_version": 3,
  "name": "Drag Shelf Smart Upload",
  "version": "1.0.0",
  "description": "Choose files from your local Drag Shelf when a website asks you to upload a file.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:32145/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}